{
  "info": {
    "_postman_id": "d0d48084-f1c8-4e5d-b143-f6387b6c3f86",
    "name": "FIT4110 Lab 05 Compose",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "API health includes dependency readiness",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('status is 200', () => pm.response.to.have.status(200));",
            "pm.test('service is ready', () => pm.expect(pm.response.json().status).to.eql('ok'));"
          ]
        }
      }]
    },
    {
      "name": "Protected endpoint rejects a missing token",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/readings/latest"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('status is 401', () => pm.response.to.have.status(401));",
            "pm.test('problem+json response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'));"
          ]
        }
      }]
    },
    {
      "name": "Create a sensor reading through API, AI and DB",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{authToken}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"device_id\": \"ESP32-LAB-A01\",\n  \"metric\": \"temperature\",\n  \"value\": 31.5,\n  \"unit\": \"celsius\",\n  \"timestamp\": \"2026-06-10T03:30:00Z\"\n}"
        },
        "url": "{{baseUrl}}/readings"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('status is 201', () => pm.response.to.have.status(201));",
            "const body = pm.response.json();",
            "pm.expect(body.accepted).to.eql(true);",
            "pm.environment.set('readingId', body.reading_id);"
          ]
        }
      }]
    },
    {
      "name": "Read the persisted sensor reading",
      "request": {
        "method": "GET",
        "header": [
          {"key": "Authorization", "value": "Bearer {{authToken}}"}
        ],
        "url": "{{baseUrl}}/readings/{{readingId}}"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('status is 200', () => pm.response.to.have.status(200));",
            "pm.test('reading came from persistence', () => pm.expect(pm.response.json().reading_id).to.eql(pm.environment.get('readingId')));"
          ]
        }
      }]
    },
    {
      "name": "AI service health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{aiBaseUrl}}/health"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('status is 200', () => pm.response.to.have.status(200));",
            "pm.test('AI service is ready', () => pm.expect(pm.response.json().service).to.eql('ai-service'));"
          ]
        }
      }]
    }
  ]
}
